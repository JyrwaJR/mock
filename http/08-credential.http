# ============================================================
# Credential — manage stored credentials (e.g. API keys).
# Docs: https://opencode.ai/v2/docs/api
# ============================================================

@baseUrl = http://localhost:4096

### Update credential
PATCH {{baseUrl}}/api/credential/{{credentialID}}
Content-Type: application/json

{
  "key": "sk-new-api-key-value"
}

### Remove credential
DELETE {{baseUrl}}/api/credential/{{credentialID}}

### Activate credential
POST {{baseUrl}}/api/credential/{{credentialID}}/activate
Content-Type: application/json

{
  "key": "sk-xxxxxxxxxxxx"
}