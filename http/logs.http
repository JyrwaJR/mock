@baseUrl=http://localhost:3000

### Write a batch of logs
POST {{baseUrl}}/api/logs
Content-Type: application/json

[
  {
    "app": "pensioners",
    "type": "info",
    "message": "User logged in",
    "content": { "userId": "u_123" }
  },
  {
    "app": "pensioners",
    "type": "error",
    "message": "Failed to load statement",
    "content": { "status": 500 }
  }
]

### Read all logs (newest-first)
GET {{baseUrl}}/api/logs

### Read logs for one UTC day
GET {{baseUrl}}/api/logs?from=2026-10-09&to=2026-10-09

### Read logs within a timestamp range
GET {{baseUrl}}/api/logs?from=2026-10-09T00:00:00.000Z&to=2026-10-09T23:59:59.999Z

### Read only error and warn logs
GET {{baseUrl}}/api/logs?type=error&type=warn

### Search messages containing "timeout" (case-insensitive)
GET {{baseUrl}}/api/logs?q=timeout

### Combine filters (errors mentioning boom on a date)
GET {{baseUrl}}/api/logs?from=2026-10-09&to=2026-10-09&type=error&q=boom

### Clear all logs
DELETE {{baseUrl}}/api/logs
