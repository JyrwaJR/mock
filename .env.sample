# ------------------------------------------------------------------
# Environment variable reference (COMMITTED sample)
# Copy this file to `.env` and fill in real values.
#   cp .env.sample .env
#
# Sensitivity markers:
#   [SECRET]  never commit a real value, never log it
#   [CONFIG]  safe to log the key name, never the value
#   [PUBLIC]  NEXT_PUBLIC_ / EXPO_PUBLIC_ prefix, safe for client bundle
# ------------------------------------------------------------------

# [CONFIG] Runtime environment: development | production | test
NODE_ENV=development

# [SECRET] PostgreSQL connection string used by Prisma
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DB_NAME

# [SECRET] JWT signing secrets (long random strings in production)
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me
JWT_PASSWORD_RESET_SECRET=change-me

# [CONFIG] JWT claims
JWT_AUDIENCE=mock
JWT_ISSUER=mock

# [CONFIG] JWT expiry (jose time string: e.g. 15m, 7d, 1h)
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d
PASSWORD_RESET_TOKEN_EXPIRY=1h

# [CONFIG] OTP settings
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN=60

# [SECRET] Fernet keys for CPPS/legacy encryption (public in the app, but keep random per environment)
FERNET_KEY=teLsk6phrMHFKeSgsO62ZSF1mR_E5rbEY1z8DCDfuwc=
CPPS_FERNET_KEY=teLsk6phrMHFKeSgsO62ZSF1mR_E5rbEY1z8DCDfuwc=

# [SECRET] EIS mock encryption key/IV overrides (optional)
EIS_APP_SECRET=3oiEGuR3zKuv1FKL
EIS_APP_IV=EisApp

# [CONFIG] Base URLs for API clients
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:3000
TARGET_BASE_URL=http://localhost:3000
