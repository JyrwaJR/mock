# ------------------------------------------------------------------
# Environment variable reference (COMMITTED sample)
# Copy this file to `.env` and fill in real values.
#   cp .env.sample .env
#
# Sensitivity markers:
#   [SECRET]  never commit a real value, never log it
#   [CONFIG]  safe to log the key name, never the value
#   [PUBLIC]  NEXT_PUBLIC_ / EXPO_PUBLIC_ prefix, safe for client bundle
# ------------------------------------------------------------------

# [CONFIG] Runtime environment: development | production | test
NODE_ENV=development

# [CONFIG] Directory overrides for the echo mock stores. These are
# independent — point them at separate volumes to keep the two stores
# apart. PAYLOAD_DATA_DIR owns the payload store (payload.json);
# ECHO_REGISTRY_FILE owns the registry (registry.json) and doubles as
# the fallback directory for payloads when PAYLOAD_DATA_DIR is unset.
PAYLOAD_DATA_DIR="/var/lib/mock/payload"
ECHO_REGISTRY_FILE="/var/lib/mock/registry"

# [CONFIG] Directory override for the logs store. Owns logs.json (the
# append-only JSON array of captured frontend logs). Defaults to
# data/logs when unset.
LOGS_DATA_DIR="/var/lib/mock/logs"

# [SECRET] JWT signing secrets (long random strings in production)
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me
JWT_PASSWORD_RESET_SECRET=change-me

# [CONFIG] JWT claims
JWT_AUDIENCE=mock
JWT_ISSUER=mock

# [CONFIG] JWT expiry (jose time string: e.g. 15m, 7d, 1h)
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d
PASSWORD_RESET_TOKEN_EXPIRY=1h

# [CONFIG] OTP settings
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN=60

# [SECRET] Fernet keys for CPPS/legacy encryption (public in the app, but keep random per environment)
FERNET_KEY=teLsk6phrMHFKeSgsO62ZSF1mR_E5rbEY1z8DCDfuwc=
CPPS_FERNET_KEY=teLsk6phrMHFKeSgsO62ZSF1mR_E5rbEY1z8DCDfuwc=

# [SECRET] EIS mock encryption key/IV overrides (optional)
EIS_APP_SECRET=3oiEGuR3zKuv1FKL
EIS_APP_IV=EisApp

# [CONFIG] Base URLs for API clients
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:3000
TARGET_BASE_URL=http://localhost:3000

# [CONFIG] Swagger API explorer — URL of the OpenAPI (Swagger) spec JSON (required)
SWAGGER_API_URL=
# [CONFIG] Base URL of the target API the swagger proxy forwards to
SWAGGER_BASE_URL=
# [SECRET] Optional API key injected as x-api-key into every proxied request
SWAGGER_API_KEY=
