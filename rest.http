### Send Expo Push Notification
# Replace the token with a real Expo push token for testing
POST http://localhost:3000/api/notifications/send
Content-Type: application/json

{
  "token": "{{EXPO_PUSH_TOKEN}}",
  "title": "Test Notification",
  "body": "This is a test push notification sent from the API.",
  "data": {
    "type": "test",
    "screen": "home"
  },
  "richContent":{"image":"https://cdn.wallpapersafari.com/21/15/wGq4Jh.jpg"},
  "priority": "high",
  "badge": 1,
  "sound": "default"
}

### Minimal request (required fields only)
POST http://localhost:3000/api/notifications/send
Content-Type: application/json

{
  "token": "{{EXPO_PUSH_TOKEN}}",
  "title": "Hello",
  "body": "World"
}

### Invalid token (should return 400)
POST http://localhost:3000/api/notifications/send
Content-Type: application/json

{
  "token": "invalid-token",
  "title": "Hello",
  "body": "World"
}

### Missing required fields (should return 400)
POST http://localhost:3000/api/notifications/send
Content-Type: application/json

{
  "token": "ExponentPushToken[xxxxxxxxxxxxxxxxxxxxxx]",
  "title": "Hello"
}


### Missing required fields (should return 400)
POST http://localhost:3000/api/trpc/post.hello?input=helo
Content-Type: application/json

{
  "name":"helo"
}


# ============================================================
# CPPS PensionersApp mocks (/api/cpps/...)
# Switch response shapes via src/features/cssp/api/registry.ts
# ============================================================
@baseUrl = http://localhost:3000

### CPPS mock — login (success; tokens are fixed mock strings)
POST {{baseUrl}}/api/cpps/PensionersApp/v1/login
Content-Type: application/json

{ "version": "24", "username": "plain-ppo", "password": "x" }

### CPPS mock — logout (needs accessToken header)
POST {{baseUrl}}/api/cpps/PensionersApp/v1/logout
Content-Type: application/json
Authorization: accessToken cpps-mock-access-token

{}

### CPPS mock — logout with 'expired' token → 202 (Access denied)
POST {{baseUrl}}/api/cpps/PensionersApp/v1/logout
Content-Type: application/json
Authorization: accessToken expired

{}

### CPPS mock — get_registration_status
POST {{baseUrl}}/api/cpps/PensionersApp/v1/get_registration_status
Content-Type: application/json

{ "version": "24", "ppo_no": "plain-ppo" }

### CPPS mock — create_pensioner
POST {{baseUrl}}/api/cpps/PensionersApp/v1/api/create_pensioner
Content-Type: application/json

{ "ppo_no": "plain-ppo", "password": "x", "bank_account_number": "y", "dob": "01-01-1965" }

### CPPS mock — change_password (switch CURRENT_VARIANT to 'access_denied' for 403)
POST {{baseUrl}}/api/cpps/PensionersApp/v1/api/change_password
Content-Type: application/json
Authorization: accessToken cpps-mock-access-token

{ "oldPassword": "a", "newPassword": "b" }

### CPPS mock — verification (face match)
POST {{baseUrl}}/api/cpps/PensionersApp/v1/api/verification
Content-Type: application/json
Authorization: accessToken cpps-mock-access-token

{ "image_1": "base64-photo" }

### CPPS mock — verification_status
POST {{baseUrl}}/api/cpps/PensionersApp/v1/api/verification_status
Content-Type: application/json
Authorization: accessToken cpps-mock-access-token

{}

### CPPS mock — lc (life certificate submission)
POST {{baseUrl}}/api/cpps/PensionersApp/v1/api/lc
Content-Type: application/json
Authorization: accessToken cpps-mock-access-token

{ "ver_mode_code": "01", "selfVerNec": "Yes", "selfVerNmc": "No", "self_ver_code": "1", "place": "TREASURY" }

### CPPS mock — validate_token (any non-empty accessToken passes)
POST {{baseUrl}}/api/cpps/PensionersApp/v1/api/validate_token
Content-Type: application/json
Authorization: accessToken cpps-mock-renew-token

{ "uid": "NzgwMDAwMDEwMDAwMDAx" }

### CPPS mock — summary (admin counts; spaced key preserved)
POST {{baseUrl}}/api/cpps/PensionersApp/v1/summary
Content-Type: application/json

{ "username": "D@p@2021" }

### CPPS mock — summary_ppo (admin per-PPO status)
POST {{baseUrl}}/api/cpps/PensionersApp/v1/summary_ppo
Content-Type: application/json

{ "username": "MegPlc@2021", "ppo_no": "12345678" }

# ============================================================
# Swagger explorer (/api/swagger/...)
# Requires SWAGGER_API_URL (+ optional SWAGGER_BASE_URL) env
# ============================================================

### Swagger — fetch the OpenAPI spec
GET {{baseUrl}}/api/swagger/spec
Accept: application/json

### Swagger — proxy a GET upstream (example: /pensioners)
GET {{baseUrl}}/api/swagger/proxy/pensioners
Authorization: Bearer <token>

### Swagger — proxy a POST upstream (JSON body forwarded)
POST {{baseUrl}}/api/swagger/proxy/pensioners
Content-Type: application/json
Authorization: Bearer <token>

{ "name": "Example Pensioner" }

# ============================================================
# Echo (/api/echo) is a persisted mock registry. POST
# { "url": "/path", "data": {...}, "status_code": 201 } to
# register a mock; requests to /api/echo/<url> return the
# entry's data with its status code. Submitting a body without
# a `url` registers the default fallback, which is returned for
# any path with no exact match. Entries persist in
# data/echo/registry.json across server restarts.
# ============================================================

### Echo — register the default fallback (no url; echoes data back and stores it)
POST {{baseUrl}}/api/echo
Content-Type: application/json

{
  "data": {
    "hello": "world",
    "count": 42
  }
}

### Echo — register a mock for /articles/1 with status 201
POST {{baseUrl}}/api/echo
Content-Type: application/json

{
  "url": "/articles/1",
  "data": {
    "title": "Hello"
  },
  "status_code": 201
}

### Echo — register a mock for /healthz (default status 200)
POST {{baseUrl}}/api/echo
Content-Type: application/json

{
  "url": "/healthz",
  "data": {
    "status": "ok"
  }
}

### Echo — list all registered entries ("*" is the fallback entry)
GET {{baseUrl}}/api/echo

### Echo — matched lookup (expect 201 + {"title":"Hello"})
GET {{baseUrl}}/api/echo/articles/1

### Echo — matched lookup via POST (body ignored; lookup by path)
POST {{baseUrl}}/api/echo/articles/1

### Echo — unmatched path falls back to the url-less default entry
GET {{baseUrl}}/api/echo/missing

